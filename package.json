{
  "name": "dacheum-platform",
  "version": "1.0.0",
  "description": "다채움 통합 교육 플랫폼 - 품질 제고사업 실동작",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config=test/e2e/smoke.config.js",
    "test:all": "node --test --test-concurrency=1 \"test/*.test.js\" && playwright test",
    "test:canary": "node scripts/age-db-canary.js --days 91 --out data/_canary.db --run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "connect-sqlite3": "^0.9.16",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
